PUBLIC_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data-v2
SUB_STORE_URL=http://127.0.0.1:39091/gateway
MIAOSPEED_URL=ws://127.0.0.1:39092/miaospeed
# Docker must be able to reach the authenticated temporary chain listener on this host.
# On Windows Docker Desktop use the host LAN IPv4: host.docker.internal may make
# Mihomo advertise 127.0.0.1 for SOCKS UDP. Compose deployment uses submeld instead.
MIAOSPEED_BRIDGE_HOST=host.docker.internal
# Use a random token shared by SubMeld and miaospeed. Production PUBLIC_ORIGIN uses HTTPS.
MIAOSPEED_TOKEN=
